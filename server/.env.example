# SmartPack server 环境变量模板 — 复制/填写到同目录的 .env(.env 不进 git)
# ============================================================

# ---- 衣物识别(必填,二选一套) ----
# 默认:阿里云百炼 DashScope(推荐,国内直连)
#   开通:https://bailian.console.aliyun.com → 开通模型服务 → API-KEY 管理 → 创建
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# 换 OpenAI 的话,注释掉上面两行 BASE_URL/MODEL,改用:
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

# ---- 电商搜同款(可选,配了才启用;jd / taobao 二选一或都配) ----
# 优先用哪家:jd 或 taobao(不填则谁配置了用谁,京东优先)
ECOMMERCE_PROVIDER=jd

# 京东联盟(京东宙斯开放平台)
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=

# 淘宝客(淘宝开放平台 TOP + 淘宝联盟推广位)
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
