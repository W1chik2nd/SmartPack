# SmartPack server 环境变量模板 — 复制/填写到同目录的 .env(.env 不进 git)
# ============================================================
#
#   cp server/.env.example server/.env
#
# 这里只放占位符,绝不要填真实 key。

# ---- 衣物识别(必填,二选一套) ----
# 默认:阿里云百炼 DashScope(推荐,国内直连)
#   开通:https://bailian.console.aliyun.com → 开通模型服务 → API-KEY 管理 → 创建
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# 换 OpenAI 的话,注释掉上面两行 BASE_URL/MODEL,改用:
# VISION_API_KEY=
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini

# ---- 电商搜同款(可选,配了才启用;jd / taobao 二选一或都配) ----
# 优先用哪家:jd 或 taobao(不填则谁配置了用谁,京东优先)
ECOMMERCE_PROVIDER=jd

# 京东联盟(京东宙斯开放平台)
JD_UNION_APP_KEY=
JD_UNION_APP_SECRET=

# 淘宝客(淘宝开放平台 TOP + 淘宝联盟推广位)
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=

# ---- 景点配图(可选,不配也能跑) ----
# 行程页的景点卡片配图。三家任选,按 key 自动选;都不配则用免 key 的 Openverse。
#   PHOTO_PROVIDER 显式指定用哪家:unsplash / pexels / openverse
PHOTO_PROVIDER=unsplash
#
# Unsplash(推荐,图质量最好)
#   申请:https://unsplash.com/developers → New Application → 拿 Access Key
#   免费额度:Demo 模式 50 次/小时。许可要求署名,卡片上已带 credit。
UNSPLASH_ACCESS_KEY=
#
# Pexels(备选)
#   申请:https://www.pexels.com/api/ → 拿 API Key
PEXELS_API_KEY=
#
# Openverse(Creative Commons 官方图库)免 key,匿名有速率限制,作兜底用,
# 无需在此配置任何东西。

# ---- AI 助手 / 旅行 Agent(共用同一套 API) ----
# 留空时其他功能照常运行;填写后同时启用聊天与完整旅行方案生成。
# 旅行 Agent 使用 OpenAI Responses API + web search + Structured Outputs。
# AI_API_KEY 只放在本机 server/.env,不要放到 client 或提交进 Git。
# 聊天仍兼容其他供应商;旅行 Agent 需要支持 Responses API 的 OpenAI 配置:
#   OpenAI:    AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   DeepSeek:  AI_BASE_URL=https://api.deepseek.com/v1    AI_MODEL=deepseek-chat
#   Ollama:    AI_BASE_URL=http://localhost:11434/v1      AI_MODEL=llama3.1
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-5.6-terra
# 可选:只覆盖旅行 Agent 的模型;不填时直接复用 AI_MODEL。
TRIP_AGENT_MODEL=gpt-5.6-terra
