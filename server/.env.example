# SmartPack AI configuration.
# Copy this file to server/.env and fill in your key — .env is gitignored,
# never commit real keys.
#
#   cp server/.env.example server/.env
#
# AI_API_KEY is the only required value. The endpoint speaks the
# OpenAI-compatible chat protocol, so any such provider works:
#   OpenAI:    AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   DeepSeek:  AI_BASE_URL=https://api.deepseek.com/v1    AI_MODEL=deepseek-chat
#   Ollama:    AI_BASE_URL=http://localhost:11434/v1      AI_MODEL=llama3.1

AI_API_KEY=sk-AvLIXh1dD8r90ErnCe3b56A8Ac14433892Ef9bD5C97a0fC6
AI_BASE_URL=https://api.openai-next.com
AI_MODEL=gpt-5
